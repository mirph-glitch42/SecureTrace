# Python build/test artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# Test fixture evidence must be committed despite the dist/ rule above (SB-01 corpus path)
!tests/fixtures/rmf/mini-repo/dist/
!tests/fixtures/rmf/mini-repo/dist/sbom.json

# Derived RMF evidence bundles (make rmf-bundle) — regenerated on demand, never committed
artifacts/

# Project-global virtual environment (lives at repo root, never committed)
.venv/

# Secrets — real env files never enter the repo (see .env.example)
.env
.env.*
!.env.example

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# OS / IDE noise
.DS_Store
.idea/
.vscode/
