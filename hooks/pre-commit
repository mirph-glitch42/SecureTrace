#!/usr/bin/env bash
# SecureTrace pre-commit gate.
# Kept in sync with the Makefile `gate` target and the quality job in
# .github/workflows/ci.yml — add a stage here, there, and in CI in the same change.
#
# Stages (fast → slow):
#   1. format-check   ruff format --check on src/tests/scripts
#   2. lint           ruff check on src/tests/scripts
#   3. docs-check     store-rendered docs (BACKLOG/LESSONS/INDEX) in sync + ALRK TSV indexes fresh
#   4. workflow-check strict-parse .github/workflows YAML (duplicate mapping keys, B8)
#   5. secrets        gitleaks over staged changes
#   6. tests          fast subset: tests for changed modules (full suite runs on pre-push/CI)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/python ]; then
  echo "✗ .venv not found — run 'make setup' (or 'make setup-ci' on CI)." >&2
  exit 1
fi

step() { printf '\n▶ %s\n' "$1"; }

step "1/6 format-check (ruff format --check)"
make -s format-check

step "2/6 lint (ruff check)"
make -s lint

step "3/6 docs-check (store docs in sync + ALRK TSV indexes)"
make -s docs-check

step "4/6 workflow-check (duplicate YAML keys in .github/workflows)"
make -s workflow-check

step "5/6 secret-scan-staged (gitleaks)"
make -s secret-scan-staged

step "6/6 test-changed (tests for changed modules)"
make -s test-changed

printf '\n✓ pre-commit gate green\n'
