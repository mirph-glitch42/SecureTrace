#!/usr/bin/env bash
# SecureTrace pre-push gate: the full, slow set of checks.
# Local pre-commit covers format/lint/docs/staged-secrets/changed-tests;
# pre-push guarantees nothing untested or secret-bearing reaches the remote.
#
# Stages:
#   1. build        compileall over the package
#   2. test         full pytest suite
#   3. secrets      gitleaks over full history
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -x .venv/bin/python ]; then
  echo "✗ .venv not found — run 'make setup' (or 'make setup-ci' on CI)." >&2
  exit 1
fi

step() { printf '\n▶ %s\n' "$1"; }

step "1/3 build (python -m compileall)"
make -s build

step "2/3 test (full pytest suite)"
make -s test

step "3/3 secret-scan (gitleaks full history)"
make -s secret-scan

printf '\n✓ pre-push gate green\n'
