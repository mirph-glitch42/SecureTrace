# SecureTrace environment variables — placeholders only, never real values.
# Copy to `.env` for local use (`.env` is gitignored). In CI the same names
# are injected from repository secrets; nothing real ever lives in this file.

# GitHub token for the release workflow (CI repository secret: GITHUB_TOKEN).
# Local use only if you run release steps by hand. Never commit a real value.
GITHUB_TOKEN=placeholder_token_github_release

# PyPI API token — needed only for publishing (backlog B5+, not yet built).
PYPI_API_TOKEN=placeholder_token_pypi_publishing
